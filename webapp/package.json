{
  "name": "datalab-vue",
  "version": "0.0.0-git",
  "private": true,
  "workspaces": [
    "src/plugins/*"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "serve": "VUE_APP_GIT_VERSION=$(node scripts/get-version.js) vite",
    "build": "VUE_APP_GIT_VERSION=$(node scripts/get-version.js) vite build",
    "preview": "vite preview",
    "test:component": "cypress run --component",
    "test:e2e": "cypress open --e2e",
    "test:e2e:headless": "cypress run --e2e",
    "test:e2e:docker": "DATALAB_E2E_SEED_COMMAND='docker compose exec -T api-dev /opt/.venv/bin/invoke dev.seed-e2e-users' cypress run --e2e",
    "lint": "eslint --ext .js,.jsx,.vue ."
  },
