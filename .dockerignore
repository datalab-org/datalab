**/node_modules
**/cypress
**/.venv
**/build
**/files

# The production image takes its settings at runtime; a local `.env` should not
# end up compiled into the bundle.
webapp/.env*

# Plugin panels are generated from the installed Python environment during the
# frontend image build. Never let stale host-generated output enter that build.
webapp/src/plugins/*
!webapp/src/plugins/index.js
